+def robotwin_ids(gt_video_path: Path):
+    """Map official HF test_dataset/video/episodeN.mp4 -> (fixed_scene_task, episodeN)."""
+    stem = gt_video_path.stem
+    if gt_video_path.parent.name == "video" and stem.startswith("episode"):
+        return "fixed_scene_task", stem
+    parts = gt_video_path.parts
+    return parts[-5], stem
+
+
+def find_gen_video(gen_video_dir, id1, id2):
+    n = id2[len("episode"):] if id2.startswith("episode") else id2
+    cands = [
+        Path(gen_video_dir) / f"{id1}_{id2}.mp4",
+        Path(gen_video_dir) / f"{id1}_episode_{n}.mp4",
+        Path(gen_video_dir) / f"{id1}_episode{n}.mp4",
+    ]
+    if str(n).isdigit():
+        cands.append(Path(gen_video_dir) / f"{id1}_episode_{int(n)}.mp4")
+    for c in cands:
+        if c.exists():
+            return c
+    return None
