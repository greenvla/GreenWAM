+def _save_results_json(results_json, results_dict, dimension=None):
+    # Rank 0 only. Unique tmp: 8-rank os.replace of the same .tmp races on NFS.
+    if get_rank() == 0:
+        tmp_json = f"{results_json}.tmp.{os.getpid()}"
+        with open(tmp_json, "w") as f:
+            json.dump(results_dict, f, indent=2)
+            f.flush()
+            os.fsync(f.fileno())
+        os.replace(tmp_json, results_json)
+        if dimension is not None:
+            print0(f"[checkpoint] saved {dimension} -> {results_json}")
+    if dist.is_available() and dist.is_initialized():
+        dist.barrier()
+
 
