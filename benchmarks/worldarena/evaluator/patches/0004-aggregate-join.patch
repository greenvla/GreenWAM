+def _canonical_video_id(name: str) -> str:
+    """Unify Video_ID so jpeg-path and VLM stem join.
+
+    jpeg:  .../fixed_scene_task/episode1/1/video -> fixed_scene_task_episode1
+    VLM:   fixed_scene_task_episode_1.mp4        -> fixed_scene_task_episode1
+    """
+    name = (name or "").strip()
+    m = _EPISODE_TAIL.match(name)
+    if m:
+        return f"{m.group('task')}_episode{m.group('num')}"
+    return name
+
